# ---------------------------------------------------------------------------
# Every key below is OPTIONAL. With an empty .env the app still runs:
# Hyperliquid market data is public, and Privy / PostHog / Sentry degrade to
# clearly-labelled stubs. Copy to `.env` and fill in what you want to exercise.
# ---------------------------------------------------------------------------

# Privy (https://dashboard.privy.io) — requires a dev client, not Expo Go.
EXPO_PUBLIC_PRIVY_APP_ID=
EXPO_PUBLIC_PRIVY_CLIENT_ID=

# PostHog (https://posthog.com) — no key means events are logged to console only.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (https://sentry.io) — no DSN means the SDK is never initialised.
EXPO_PUBLIC_SENTRY_DSN=

# Solana. Defaults to public devnet; swap for Helius/QuickNode if you get rate limited.
EXPO_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# EVM RPC for the viem read-only demo. Must be Arbitrum One, e.g. https://arb1.arbitrum.io/rpc. See ENV_SETUP.md.
EXPO_PUBLIC_EVM_RPC_URL=

# Hyperliquid. Public API, no key required. Point at testnet if you prefer.
EXPO_PUBLIC_HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
EXPO_PUBLIC_HYPERLIQUID_WS_URL=wss://api.hyperliquid.xyz/ws
